	"nodes":[
		{"id":"1d5e966482078186","type":"text","text":"```mermaid\nflowchart TD\nA[\"手动扫描\"] --> CID[\"CorrelationIdFilter<br/>生成/透传 X-Request-Id\"]\nCID --> B[\"ApiKeyAuthFilter\"]\nB --> C[\"JayAgentController\"]\n\nD[\"GitHub Webhook\"] --> CID\nF[\"GitLab Webhook\"] --> CID\nCID --> E[\"WebhookController\"]\n\nE --> G[\"WebhookSecurityService\"]\nG --> G1[\"请求大小与 Content-Type 校验\"]\nG1 --> G2[\"GitHub HMAC / GitLab Token / 共享 Secret 校验\"]\nG2 --> G3[\"事件 ID 与严格模式校验\"]\nG3 --> H[\"JSON 解析与事件去重\"]\nH --> I[\"202 Accepted\"]\nI --> J[\"WebhookReviewOrchestrator<br/>任务转交门面\"]\nJ --> J1[\"WebhookReviewTaskRepository<br/>SQLite 任务表\"]\nJ1 --> J2[\"WebhookReviewTaskDispatcher<br/>后台轮询派发\"]\nJ2 --> K1[\"GitHubWebhookParser / GitLabWebhookParser\"]\nK1 --> K2[\"GitHubApiClient / GitLabApiClient<br/>分页获取变更\"]\nK2 --> K3[\"DiffAssembler<br/>Diff 标准化 / 截断 / 空 Diff / 二进制处理\"]\n\nL[\"定时扫描\"] --> M[\"ScheduledScanner\"]\n\nC --> P[\"JayAgentScanner\"]\nM --> P\nK3 --> S1[\"WebhookService\"]\nS1 --> P\n\nP --> Q[\"ReviewPromptBuilder\"]\nQ --> R[\"VectorStore\"]\nR --> S[\"RAG 规则上下文\"]\nS --> T[\"ChatClient / LLM\"]\nT --> U[\"ReviewReportParser<br/>JSON 优先 / 旧协议回退\"]\nU --> V[\"JayAgentReport\"]\nV --> W[\"风险评分\"]\n\nW --> X[\"前端 JSON\"]\nX --> Y[\"index.html\"]\n\nS1 --> Z[\"ReviewHistoryService<br/>历史门面\"]\nW --> Z\nZ --> Z1[\"ReviewHistoryRepository / Mapper / Statistics / Migrator\"]\nZ1 --> AA[\"SQLite 审查历史\"]\n\nS1 --> AB[\"GitHub / GitLab 评论回写\"]\nS1 --> AC[\"WeChatNotifier<br/>高风险告警\"]\n\nAD[\"ExternalApiCallSupport\"] -.超时/重试/耗时日志.-> K2\nAD -.超时/重试/耗时日志.-> AB\nAD -.超时/重试/耗时日志.-> AC\n\nAE[\"ApiExceptionHandler\"] -.统一错误响应.-> C\nAE -.统一错误响应.-> E\nAE -.统一错误响应.-> Z\n\nOBS[\"ObservabilityMetrics\"] -.Webhook 接收/拒绝/重复.-> E\nOBS -.审查成功/失败.-> S1\nOBS -.RAG 耗时.-> R\nOBS -.LLM 耗时.-> T\nOBS -.外部 API 成功/失败.-> AD\nOBS -.企业微信告警成功/失败.-> AC\n\nLOG[\"logback-spring.xml<br/>JSON 结构化日志\"] -.requestId / stack_trace.-> CID\nPROM[\"/actuator/prometheus\"] <-->|Micrometer| OBS\nHEALTH[\"/actuator/health / info\"] --> PROM\n```","x":2600,"y":3500,"width":2360,"height":3200,"color":"6"}
